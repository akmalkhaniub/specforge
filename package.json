{
  "name": "specforge",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered requirements extraction platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @specforge/shared build && pnpm --filter api build && pnpm --filter web build",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@9.15.0"
}
